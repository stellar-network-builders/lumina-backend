# .env.schema - Documents all environment variables used by the backend.
# Variables marked [required] MUST be present at startup or the process will exit.
# Variables marked [optional] have safe defaults or are only needed for specific features.

# --- Server ---
NODE_ENV=development          # [required] development | production | test | staging
PORT=4000                     # [required] HTTP listen port

# --- CORS ---
FRONTEND_URL=http://localhost:3000  # [required] Allowed origin for strict CORS

# --- Database (PostgreSQL) ---
DB_HOST=localhost             # [required] Database hostname
DB_PORT=5432                  # [required] Database port
DB_NAME=vesting_vault         # [required] Database name
DB_USER=postgres              # [required] Database user
DB_PASSWORD=                  # [required] Database password

# --- JWT ---
JWT_SECRET=                   # [required] Min 16 chars - used to sign/verify JWTs

# --- WebSocket Limits ---
WS_MAX_CONNECTIONS_PER_IP=5   # [optional] Max Socket.IO connections per IP
WS_MAX_CONNECTIONS_PER_USER=3 # [optional] Max Socket.IO connections per user

# --- Transparency Signing Keys ---
TRANSPARENCY_PRIVATE_KEY=     # [required] Used by annual-statement service
TRANSPARENCY_PUBLIC_KEY=      # [required] Used by annual-statement service

# --- Stellar / Soroban ---
STELLAR_RPC_URL=https://horizon-testnet.stellar.org       # [required]
STELLAR_NETWORK=testnet                                    # [required] testnet | mainnet | futurenet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"  # [required]
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org   # [required]
SOROBAN_RPC_URL=https://soroban-rpc.testnet.stellar.org   # [required]
VAULT_CONTRACT_ADDRESS=                                   # [required] Soroban contract address

# --- Off-Ramp (SEP-24) ---
STELLAR_ANCHORS=testanchor.stellar.org:USDC,apay.io:USDC  # [optional] Comma-separated domain:asset pairs
SWAP_FEE_PERCENT=0.3                                      # [optional] Fee % for token-to-stablecoin swap

# --- Discord Bot (optional) ---
DISCORD_BOT_TOKEN=            # [optional] Discord bot token
DISCORD_CHANNEL_ID=           # [optional] Discord channel ID for alerts

# --- Redis ---
REDIS_URL=redis://localhost:6379  # [required] Redis connection string

# --- Slack (optional) ---
SLACK_WEBHOOK_URL=            # [optional] Slack incoming webhook URL

# --- Email (optional - needed for notifications) ---
EMAIL_HOST=smtp.mailtrap.io   # [optional] SMTP host
EMAIL_PORT=2525               # [optional] SMTP port
EMAIL_USER=                   # [optional] SMTP username
EMAIL_PASS=                   # [optional] SMTP password
EMAIL_FROM=no-reply@vestingvault.com  # [optional] Sender address

# --- Firebase Push Notifications (optional) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json  # [optional]
# FIREBASE_SERVICE_ACCOUNT_KEY={...}                            # [optional] JSON string alternative

# --- OpenTelemetry / Jaeger ---
OTEL_SERVICE_NAME=vesting-vault-backend   # [optional] Service name for tracing
OTEL_EXPORTER_JAEGER_ENDPOINT=http://jaeger:14268/api/traces  # [optional]
OTEL_TRACES_SAMPLE_RATE=1.0               # [optional] 0.0 - 1.0
ENABLE_JAEGER=true                        # [optional] Enable Jaeger exporter
ENABLE_OTLP=false                         # [optional] Enable OTLP exporter
OTEL_CONSOLE_EXPORT=false                 # [optional] Print traces to stdout
